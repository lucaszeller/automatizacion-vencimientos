# ============================================================
# MODO DE EJECUCION
# ============================================================

APP_ENV=development

# IMPORTANTE: definir explicitamente esta variable.
# Si no esta presente en el .env, la app asume modo REAL y lo advierte en el log.
# true  → simula envios, no manda WhatsApp reales (recomendado para pruebas)
# false → modo real, envia mensajes a clientes
MODO_PRUEBA=true


# ============================================================
# FUENTE DE DATOS
# ============================================================

# database → se conecta a TacticaSoft via SQL (produccion)
# excel    → lee un archivo Excel local (DATA_INPUT_PATH)
# sample   → usa datos de prueba internos (no requiere nada externo)
DATA_SOURCE=database

# Solo se usa cuando DATA_SOURCE=excel
EXCEL_INPUT_PATH=data/entrada/servicios_prueba.xlsx


# ============================================================
# CONEXION A TACTICASOFT (cuando DATA_SOURCE=database)
# ============================================================

# Motor: mysql o sqlserver
DB_ENGINE=mysql
DB_HOST=CAMBIAR_HOST
DB_PORT=3307
DB_NAME=CAMBIAR_NOMBRE_BD
DB_USER=CAMBIAR_USUARIO
DB_PASSWORD=CAMBIAR_CLAVE

# Solo para sqlserver: nombre del driver ODBC instalado
DB_DRIVER=ODBC Driver 17 for SQL Server

# Ruta al archivo SQL de consulta (SELECT read-only sobre TacticaSoft)
DB_QUERY_PATH=sql/tacticasoft_services.sql


# ============================================================
# REGLAS DE AVISO
# ============================================================

# Dias de anticipacion para avisar antes del vencimiento estimado
DIAS_ANTES_AVISO=7

# Horas de uso entre services (umbral para calcular fecha estimada)
HORAS_PARA_PROXIMO_SERVICE=250

# true  → permite reenviar un aviso aunque ya se haya enviado antes
# false → evita duplicar avisos (recomendado)
REENVIAR_AVISO=false

# Cantidad de dias que se conservan los reportes diarios services_proximos_*.xlsx
# Los archivos mas viejos se eliminan automaticamente al finalizar cada ejecucion diaria
DIAS_CONSERVAR_REPORTES_DIARIOS=30


# ============================================================
# WHATSAPP — PROVEEDOR
# ============================================================

# meta  → usa la Cloud API oficial de Meta (requiere WHATSAPP_TOKEN y WHATSAPP_PHONE_NUMBER_ID)
# local → usa el servidor local whatsapp-web.js (requiere tener corriendo Iniciar WhatsApp Server.bat)
WHATSAPP_PROVIDER=local

# URL del servidor local (solo se usa cuando WHATSAPP_PROVIDER=local)
# No cambiar salvo que use un puerto distinto
WHATSAPP_LOCAL_URL=http://127.0.0.1:3000


# ============================================================
# WHATSAPP — CLOUD API DE META (cuando WHATSAPP_PROVIDER=meta)
# ============================================================

# URL base de la API (no cambiar salvo actualizacion de version)
WHATSAPP_API_URL=https://graph.facebook.com/v20.0

# Token de acceso permanente generado en Meta for Developers
WHATSAPP_TOKEN=

# ID del numero de telefono configurado en la app de Meta
WHATSAPP_PHONE_NUMBER_ID=

# Prefijo de pais que se agrega automaticamente a numeros sin codigo internacional
# Se puede escribir con o sin +  (ej: 54 o +54)
# Argentina = 54, Uruguay = 598, Chile = 56, Brasil = 55
WHATSAPP_COUNTRY_PREFIX=54

# Numero interno que recibe el resumen de cada ejecucion
# Formato internacional sin + ni espacios, ej: 5491112345678
WHATSAPP_ADMIN_NUMBER=
ENVIAR_RESUMEN_ADMIN=true

# Numero personal para el boton "Probar con mi numero" de la UI.
# Envia el primer vencimiento pendiente a este numero para verificar que el mensaje llega bien.
# Formato internacional sin + ni espacios, ej: 5491112345678
WHATSAPP_TEST_NUMBER=
ENVIAR_RESUMEN_ADMIN=true


# ============================================================
# CARPETAS DE DATOS
# ============================================================

OUTPUT_DIR=data/reportes
SERVICES_DB_PATH=data/services.db
LOG_DIR=data/logs
ENVIADOS_DIR=data/enviados
ERRORES_DIR=data/errores
RESPALDOS_DIR=data/respaldos


# ============================================================
# WHATSAPP — ANTI-BAN (pausa entre mensajes)
# ============================================================

# Segundos minimos y maximos de pausa aleatoria entre cada mensaje enviado.
# Simula comportamiento humano para reducir el riesgo de ban.
# En modo prueba (MODO_PRUEBA=true) estas pausas NO se aplican.
WHATSAPP_DELAY_MIN=5
WHATSAPP_DELAY_MAX=15


# ============================================================
# HOJAS DE RUTA (Google Sheets + OpenRouteService)
# ============================================================

# JSON del Service Account de Google Cloud (proyecto porta-produccion).
# Descargalo desde Google Cloud > IAM > Cuentas de servicio > Claves.
# Acordate de compartir el Sheet con el email del service account (permiso Editor).
GOOGLE_CREDENTIALS_PATH=credenciales/google_service_account.json

# ID del Sheet "Pedido de servicios" (el codigo largo de la URL)
SHEET_PEDIDOS_ID=1IQyZ3ZlzVw7DKgc2_iiwUjAVu17pFHPWe_twbVtatIU

# Nombre de la pestana. Vacio = primera pestana del libro.
SHEET_PEDIDOS_HOJA=

# API key de OpenRouteService (gratis, sin tarjeta: openrouteservice.org)
ORS_API_KEY=

# Punto de partida y regreso de las rutas
TALLER_DIRECCION=
# Opcional: "lat,lon" del taller. Si se completa, evita geocodificar.
TALLER_COORDS=

# Carpeta donde se guardan los PDF generados
HOJAS_RUTA_DIR=data/hojas_ruta


# ============================================================
# GOOGLE CALENDAR (agenda del mecanico)
# ============================================================

# Calendario donde se publican los eventos.
# Puede ser un mail (calendario principal de esa cuenta) o un ID de
# calendario secundario (xxxxx@group.calendar.google.com).
# IMPORTANTE: hay que compartir ese calendario con el email del service
# account, con permiso "Realizar cambios en los eventos".
CALENDAR_ID_DEFECTO=

# Opcional: un calendario distinto por mecanico.
# CALENDAR_MECANICOS=Pablo=pablo@empresa.com;Emiliano=emiliano@empresa.com
CALENDAR_MECANICOS=

# Crear bloques de "Viaje a X (74 km)" entre paradas
CALENDAR_EVENTOS_VIAJE=true

# Hora de salida del taller
JORNADA_INICIO=08:00
JORNADA_MAX_HORAS=9
ZONA_HORARIA=America/Argentina/Buenos_Aires

# Minutos estimados de trabajo cuando no hay una regla que aplique
DURACION_SERVICE_DEFECTO=90

# Opcional: reglas propias, evaluadas antes que las del sistema.
# DURACIONES_SERVICE=250 hs=60;1000 hs=200;semestral=120;anual=240
DURACIONES_SERVICE=
